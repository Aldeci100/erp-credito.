// Regras de segurança do Firestore para o ERP Crédito.
//
// Como aplicar: Console do Firebase → Firestore Database → Regras →
// cole este conteúdo no lugar do que estiver lá → Publicar.
//
// Só permite ler ou escrever quem estiver autenticado (logado com o
// e-mail/senha cadastrado em Authentication). Sem login válido, o
// acesso é negado — mesmo que alguém descubra a URL do site ou as
// chaves públicas de configuração do Firebase.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /dados/{documento} {
      allow read, write: if request.auth != null;
    }

  }
}
